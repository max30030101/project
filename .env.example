# Copy to .env (or export these in your shell / hosting dashboard)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Email: console backend prints the welcome email in your terminal.
# For real email (Gmail example) use the SMTP backend and an app password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=FitForge AI <no-reply@fitforge.example>

# PostgreSQL (leave POSTGRES_DB unset to use SQLite)
# POSTGRES_DB=fitforge
# POSTGRES_USER=fitforge
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
